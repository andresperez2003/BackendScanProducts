# OPENROUTER_MODEL=qwen/qwen3-vl-plus

# Contacto que ve una empresa al quedarse sin lecturas de fotos, para adquirir un plan.
# WhatsApp con indicativo del país y sin "+" ni espacios.
SOPORTE_WHATSAPP=573001234567
SOPORTE_CORREO=soporte@tu-dominio.com
# Opcional: máximo de lecturas de fotos por minuto por empresa (por defecto 6)
# LECTURAS_POR_MINUTO=6

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DB_PORT=
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
MAX_INTENTOS_LOGIN=5
MINUTOS_BLOQUEO_LOGIN=10

# Orígenes del frontend permitidos por CORS, separados por comas
CORS_ORIGINS=http://localhost:5173

# Lectura automática de lote y vencimiento en la foto (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
